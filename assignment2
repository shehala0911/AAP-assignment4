while True:
    n=input("Enter a positive odd integer (n ≥ 5): ")
    if not n.isdigit():
        print("Invalid input")
        continue
    n=int(n)
    if n<5:
        print("Must be ≥ 5")
        continue
    if n%2==0:
        print("Must be odd")
        continue
    break
m=n//2
for i in range(m+1):
    print(" "*(m-i)+"*"*(2*i+1))
for i in range(m-1,-1,-1):
    print(" "*(m-i)+"*"*(2*i+1))
